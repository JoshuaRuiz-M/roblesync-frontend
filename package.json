{
    "name": "roblesync-frontend",
    "version": "1.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "lint": "ng lint",
        "lint:fix": "ng lint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit -p tsconfig.app.json",
        "check": "npm run typecheck && npm run lint && npm run format:check"
    },
    "private": true,
    "packageManager": "npm@11.19.0",
    "dependencies": {
        "@angular/cdk": "21.2.14",
        "@angular/common": "21.2.25",
        "@angular/compiler": "21.2.25",
        "@angular/core": "21.2.25",
        "@angular/forms": "21.2.25",
        "@angular/platform-browser": "21.2.25",
        "@angular/router": "21.2.25",
        "@primeuix/themes": "3.0.1",
        "jsbarcode": "3.12.3",
        "primeicons": "8.0.2",
        "primeng": "21.1.10",
        "rxjs": "7.8.2",
        "tslib": "2.3.0"
    },
    "devDependencies": {
        "@angular/build": "21.2.27",
        "@angular/cli": "21.2.27",
        "@angular/compiler-cli": "21.2.25",
        "@eslint/js": "10.0.1",
        "@types/jsbarcode": "3.11.4",
        "angular-eslint": "21.4.0",
        "eslint-config-prettier": "10.1.8",
        "jsdom": "28.0.0",
        "prettier": "3.8.1",
        "typescript": "5.9.2",
        "typescript-eslint": "8.71.2",
        "vitest": "4.1.11"
    }
}
